{
  "name": "claude-exp-launcher",
  "version": "0.1.0",
  "description": "Experiment launcher that displays a previous Claude session before starting Claude.",
  "private": true,
  "bin": {
    "claude-exp": "./bin/claude-exp.js"
  },
  "scripts": {
    "start": "node ./bin/claude-exp.js",
    "task1": "node ./bin/claude-exp.js 1",
    "task2": "node ./bin/claude-exp.js 2",
    "task3": "node ./bin/claude-exp.js 3",
    "task4": "node ./bin/claude-exp.js 4"
  },
  "engines": {
    "node": ">=18"
  }
}